# Copy to .env for local Slack bot testing (do not commit .env)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
# Optional: only needed for HTTP/Cloud Run mode (not Socket Mode)
# SLACK_SIGNING_SECRET=your-signing-secret
# Optional: restrict bot to specific Slack channel IDs (comma-separated)
# PICKUP_PAL_ALLOWED_CHANNELS=C0123456789
